# ---------------------------------------------------------------
# Datos
#
# Todo `data/` queda fuera del repo: `raw/` son descargas del INEGI
# (~5 GB) y `processed/` se regenera con `geostats.consolidar`.
# Los .gitkeep sí se versionan para que la estructura exista al clonar.
# ---------------------------------------------------------------
/data/**
!/data/raw/
!/data/processed/
!/data/**/.gitkeep

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[oc]
*$py.class
build/
dist/
wheels/
*.egg-info/
.eggs/

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Cachés de herramientas
.uv-cache/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------
# Quarto: el .qmd se versiona, lo que renderiza no. El PDF de cada
# notebook sí va al repo, pero vive en docs/, no aquí.
# ---------------------------------------------------------------
/.quarto/
notebooks/*.html
notebooks/*_files/
notebooks/*.pdf
notebooks/*.quarto_ipynb

# ---------------------------------------------------------------
# Datos sueltos fuera de data/ (red de seguridad: si se descarga algo
# a la raíz por error, no acaba en un commit de cientos de MB)
# ---------------------------------------------------------------
/*.csv
/*.zip
/*.parquet
/*.xlsx
/ATUS_*/

# Formatos geoespaciales pesados, en cualquier ubicación
*.shp
*.shx
*.dbf
*.sbn
*.sbx
*.qix
*.gpkg
*.tif
*.tiff
*.gdb/

# ---------------------------------------------------------------
# Salidas del análisis
# ---------------------------------------------------------------
/figuras/
/reportes/
*.log

# ---------------------------------------------------------------
# Secretos
# ---------------------------------------------------------------
# .env aquí solo lleva PYTHONPATH (ver README), por eso se versiona.
!.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------
# Editores
# ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~

# ---------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ---------------------------------------------------------------
# Datos procesados
#
# Las bases consolidadas sí se versionan, para que un clon tenga datos
# sin repetir los ~5 GB de descarga del INEGI.
# ---------------------------------------------------------------
!data/processed/atus_*.*

# ...menos los artefactos de limpieza. Se regeneran en segundos con
# `uv run limpiar-atus` a partir de atus_zmm.parquet, y como Parquet es
# binario comprimido git no puede hacer delta: cada versión commiteada
# se guardaría entera y se quedaría en el historial para siempre.
data/processed/*_limpio*.parquet

# Auxiliares de LaTeX (docs/reporte)
docs/reporte/*.aux
docs/reporte/*.log
docs/reporte/*.out
docs/reporte/*.toc
docs/reporte/*.fls
docs/reporte/*.fdb_latexmk
docs/reporte/*.synctex.gz

# ---------------------------------------------------------------
# App web (app/): tiene su propio .gitignore (node_modules, .next,
# public/datos, la referencia de las pruebas).
# ---------------------------------------------------------------
